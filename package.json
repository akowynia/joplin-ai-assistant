{
  "name": "joplin-plugin-ai-assistant",
  "version": "1.0.0",
  "description": "Powerful, privacy-focused AI assistant plugin for Joplin notes.",
  "main": "dist/index.js",
  "scripts": {
    "dist": "webpack --env joplin-plugin-config=buildMain && webpack --env joplin-plugin-config=buildExtraScripts && webpack --env joplin-plugin-config=createArchive",
    "prepare": "npm run dist",
    "updateVersion": "webpack --env joplin-plugin-config=updateVersion"
  },
  "license": "MIT",
  "author": "Artur Kowynia",
  "homepage": "https://github.com/akowynia/joplin-ai-assistant#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akowynia/joplin-ai-assistant.git"
  },
  "bugs": {
    "url": "https://github.com/akowynia/joplin-ai-assistant/issues"
  },
  "keywords": [
    "joplin-plugin",
    "joplin",
    "ai",
    "assistant",
    "ollama",
    "openai",
    "llm",
    "notes",
    "productivity",
    "summarizer"
  ],
  "files": [
    "publish",
    "assets"
  ],
  "devDependencies": {
    "@types/node": "^18.7.13",
    "chalk": "^4.1.0",
    "copy-webpack-plugin": "^11.0.0",
    "fs-extra": "^10.1.0",
    "glob": "^8.0.3",
    "tar": "^6.1.11",
    "ts-loader": "^9.3.1",
    "typescript": "^4.8.2",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0"
  },
  "dependencies": {
    "axios": "^1.2.0"
  }
}
